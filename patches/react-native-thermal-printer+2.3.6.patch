+  private UsbDevice findUsbPrinter(Context context, int vendorId, int productId) {
+    UsbConnection[] connections = new UsbPrintersConnections(context).getList();
+    if (connections == null) {
+      return null;
+    }
+    for (UsbConnection connection : connections) {
+      UsbDevice device = connection.getDevice();
+      // 0/0 means "caller didn't care" — take the first attached printer.
+      if (vendorId <= 0 && productId <= 0) {
+        return device;
+      }
+      if (device.getVendorId() == vendorId && device.getProductId() == productId) {
+        return device;
+      }
+    }
+    return null;
+  }
