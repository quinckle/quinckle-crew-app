{
  "expo": {
    "name": "QuinckleCrew",
    "slug": "QuinckleCrew",
    "owner": "quinckle",
    "version": "1.2.0",
    "orientation": "default",
    "icon": "./assets/images/quinckle crew icon converted.png",
    "scheme": "quincklecrew",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quinckle.crew"
    },
    "android": {
      "package": "com.quinckle.crew",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/images/quinckle crew icon converted.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "useLegacyPackaging": true,
            "enablePngCrunchInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification icon small.png",
          "color": "#F35D3B",
          "sounds": [
            "./assets/audio/notifications/waiter_notification.mp3",
            "./assets/audio/notifications/staff_call_alarm.wav",
            "./assets/audio/voice/en_female_dine_in.mp3",
            "./assets/audio/voice/en_female_takeaway.mp3",
            "./assets/audio/voice/en_female_delivery.mp3",
            "./assets/audio/voice/en_male_dine_in.mp3",
            "./assets/audio/voice/en_male_takeaway.mp3",
            "./assets/audio/voice/en_male_delivery.mp3"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/transparent.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#09090b",
          "dark": {
            "backgroundColor": "#09090b"
          }
        }
      ],
      "./plugins/withAllowNativeHeapPointerTagging",
      "./plugins/withArmOnlyAbis",
      "./plugins/withKotForegroundService",
      "./plugins/withUsbPrinter",
      "expo-secure-store",
      "react-native-fast-tflite",
      [
        "expo-camera",
        {
          "cameraPermission": "Quinckle uses the camera only to check a staff member in at the attendance station. Images are never stored or uploaded.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Quinckle Crew checks your location only when you swipe to clock in or out, to confirm you're at the restaurant.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d9a427d9-6a61-4756-a457-300e665a5104"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/d9a427d9-6a61-4756-a457-300e665a5104"
    }
  }
}
